# Credentials are imported on the Mac from its original private .env, never bundled.
LLM_PROVIDER=api
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Original developer configuration; availability has NOT been verified remotely.
LLM_MODEL_NAME=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=text-embedding-v3
QWEN_ENCODING_FORMAT=float
KD_EMBEDDING_MODE=qwen
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
KD_MONGO_URI=mongodb://127.0.0.1:27017
KD_MONGO_DATABASE=kd_dev
KD_MINIO_USER=kd_local
KD_MINIO_PASSWORD=
# Optional offline image tag after docker load; default is the pinned registry index.
KD_MINIO_IMAGE=
